---
import TagList from '@components/TagList.astro';
import type { Project } from '@lib/models';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<dialog id="project-overlay" class="project-overlay" aria-label="Project details">
  <div class="project-overlay__panel" id="project-overlay__panel"></div>
  <button class="project-overlay__close" id="project-overlay__close" aria-label="Close">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M18 6l-12 12" /><path d="M6 6l12 12" />
    </svg>
  </button>
</dialog>

{projects.map((project, index) => (
  <template id={`project-${project.slug}`} data-accent={project.accent ?? '#ff69c1'}>
    <div class="project-overlay__media">
      <img src={project.cover} alt={`${project.name} — ${project.summary}`} />
    </div>

    <div class="project-overlay__body">
      <header class="project-overlay__header">
        <span class="project-overlay__index">{String(index + 1).padStart(2, '0')}</span>
        <h2 class="project-overlay__title">{project.name}</h2>
        <p class="project-overlay__meta">
          <span>{project.year}</span>
          <span class="project-overlay__meta__sep">/</span>
          <span>{project.type}</span>
          <span class="project-overlay__meta__sep">/</span>
          <span>{project.role}</span>
        </p>
      </header>

      <p class="project-overlay__summary">{project.summary}</p>

      <div class="project-overlay__tags">
        <TagList tags={project.tags} />
        {project.abandoned && <TagList tags={['Abandoned']} />}
      </div>

      {!!project.gallery?.length && (
        <ul class="project-overlay__gallery">
          {project.gallery.map((item) => (
            <li>
              <img src={item.src} alt={item.caption ?? project.name} loading="lazy" />
              {item.caption && <span>{item.caption}</span>}
            </li>
          ))}
        </ul>
      )}

      {project.url && (
        <a
          class="project-overlay__link"
          href={project.url}
          target="_blank"
          rel="noreferrer"
        >
          <span>visitar sitio</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" /><path d="M11 13l9 -9" /><path d="M15 4h5v5" /></svg>
        </a>
      )}
    </div>
  </template>
))}

<script is:inline type="module" data-astro-rerun>
  // ClientRouter keeps `document` alive across navigations while the previous
  // <dialog> is detached, so the delegated listener has to be replaced rather
  // than added again — otherwise the stale one calls showModal() on a removed
  // element and throws InvalidStateError.
  if (window.__projectOverlayClick) {
    document.removeEventListener('click', window.__projectOverlayClick);
    window.__projectOverlayClick = null;
  }

  const dialog = document.getElementById('project-overlay');
  const panel = document.getElementById('project-overlay__panel');
  const closeButton = document.getElementById('project-overlay__close');

  if (dialog && panel && closeButton) {
    closeButton.addEventListener('click', () => dialog.close());

    // Clicking the backdrop (i.e. outside the panel) closes the dialog.
    dialog.addEventListener('click', (event) => {
      if (!panel.contains(event.target) && event.target !== closeButton) {
        dialog.close();
      }
    });

    dialog.addEventListener('close', () => {
      panel.replaceChildren();
      panel.style.removeProperty('--panel-accent');
    });

    // Event delegation so variants can render triggers however they like.
    window.__projectOverlayClick = (event) => {
      const trigger = event.target.closest('[data-project]');
      if (!trigger || !dialog.isConnected) return;

      const slug = trigger.getAttribute('data-project');
      const template = document.getElementById(`project-${slug}`);
      if (!template) return;

      event.preventDefault();

      panel.replaceChildren(template.content.cloneNode(true));
      panel.style.setProperty('--panel-accent', template.getAttribute('data-accent'));
      dialog.showModal();
    };

    document.addEventListener('click', window.__projectOverlayClick);
  }
</script>

<style is:global>
  .project-overlay {
    width: min(1080px, calc(100vw - 3.5rem));
    max-width: none;
    max-height: none;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text-color);
    overflow: visible;

    /* Keeps the panel clear of the viewport edges on short screens. */
    margin: auto;
  }

  .project-overlay::backdrop {
    background: rgb(0 0 0 / 0.72);
    backdrop-filter: blur(6px);
  }

  .project-overlay[open] {
    animation: project-overlay-in 0.28s ease both;
  }

  .project-overlay[open]::backdrop {
    animation: project-overlay-backdrop-in 0.28s ease both;
  }

  .project-overlay__panel {
    /* Overridden per project by the script below. */
    --panel-accent: var(--color-text-main);

    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: 1.25rem;
    max-height: calc(100dvh - 3rem);
    overflow-y: auto;
    background: var(--bg-secondary-color);
    border: 1px solid rgb(255 255 255 / 0.08);
  }

  .project-overlay__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--bg-color);
  }

  .project-overlay__header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-overlay__index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--panel-accent);
  }

  .project-overlay__title {
    font-family: var(--title-fonts);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    opacity: 0.95;
  }

  .project-overlay__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .project-overlay__meta__sep {
    color: var(--panel-accent);
  }

  .project-overlay__summary {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.55;
    opacity: 0.9;
  }

  .project-overlay__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .project-overlay__gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .project-overlay__gallery img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--bg-color);
  }

  .project-overlay__gallery span {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: var(--color-text-secondary);
  }

  .project-overlay__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: start;
    margin-top: 1.75rem;
    font-size: 0.85rem;
    color: var(--panel-accent);
  }

  .project-overlay__link:hover span {
    text-decoration: line-through;
  }

  .project-overlay__close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: rgb(35 37 44 / 0.8);
    color: var(--text-color);
    cursor: pointer;
  }

  .project-overlay__close:hover {
    color: var(--panel-accent);
  }

  @keyframes project-overlay-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes project-overlay-backdrop-in {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 800px) {
    .project-overlay__panel {
      grid-template-columns: 1.15fr 1fr;
      gap: 2.5rem;
      padding: 2rem;
    }

    .project-overlay__media img {
      height: 100%;
      aspect-ratio: auto;
      min-height: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-overlay[open],
    .project-overlay[open]::backdrop {
      animation: none;
    }
  }
</style>
