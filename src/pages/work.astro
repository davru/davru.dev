---
import Layout from '@layouts/Layout.astro';
import ProjectOverlay from '@components/ProjectOverlay.astro';
import TagList from '@components/TagList.astro';
import type { Project } from '@lib/models';
import data from '../../public/data/projects.json';

// Editorial index: one numbered row per project. Hovering a row swaps the source
// of the cover that follows the cursor.
const projects = (data as unknown as Project[]) ?? [];

const filters = [
	{ value: 'all', label: 'all' },
	{ value: 'web', label: 'web' },
	{ value: 'design', label: 'design' }
];

const total = String(projects.length).padStart(2, '0');
---

<Layout
	title="Work - David (davru) Sanchez"
	description="An index of the web apps, experiments and design pieces built by David (davru) Sanchez, from 2023 to today."
>
	<main class="work-index" id="work-index">
		<header class="work-index__header">
			<p class="work-index__kicker">
				Selected work <span class="work-index__count">{total}</span>
			</p>

			<div class="work-index__filters" role="group" aria-label="Filter projects by type">
				{filters.map((filter, index) => (
					<>
						{index > 0 && <span class="work-index__sep" aria-hidden="true">/</span>}
						<button
							type="button"
							class:list={['work-index__filter', { 'is-active': filter.value === 'all' }]}
							data-filter={filter.value}
							aria-pressed={filter.value === 'all' ? 'true' : 'false'}
						>
							{filter.label}
						</button>
					</>
				))}
			</div>
		</header>

		<ol class="work-index__list" id="work-index__list" role="list">
			{projects.map((project, index) => (
				<li class="work-index__item" data-type={project.type} data-cover={project.cover}>
					<button type="button" class="work-index__row" data-project={project.slug}>
						<img class="work-index__thumb" src={project.cover} alt="" loading="lazy" decoding="async" />
						<span class="work-index__number">{String(index + 1).padStart(2, '0')}</span>
						<span class="work-index__name">{project.name}</span>
						<span class="work-index__meta">
							{project.abandoned && (
								<span class="work-index__marker"><TagList tags={['Abandoned']} /></span>
							)}
							<span class="work-index__year">{project.year}</span>
							<span class="work-index__sep" aria-hidden="true">/</span>
							<span class="work-index__type">{project.type}</span>
							{project.url && (
								<span class="work-index__external" title="Live site available">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path stroke="none" d="M0 0h24v24H0z" fill="none" />
										<path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
										<path d="M11 13l9 -9" />
										<path d="M15 4h5v5" />
									</svg>
								</span>
							)}
						</span>
					</button>
				</li>
			))}
		</ol>

		<div class="work-index__cover" id="work-index__cover" aria-hidden="true">
			<img id="work-index__cover__image" alt="" decoding="async" />
		</div>
	</main>

	<ProjectOverlay projects={projects} />
</Layout>

<script is:inline type="module" data-astro-rerun>
	// Type filtering, plus the cover that eases towards the pointer. The router
	// re-executes this script after every navigation, so everything is queried
	// fresh on each run and the animation loop is fenced by the cover still being
	// in the document.
	const root = document.getElementById('work-index');
	const list = document.getElementById('work-index__list');
	const cover = document.getElementById('work-index__cover');
	const coverImage = document.getElementById('work-index__cover__image');

	if (root && list && cover && coverImage) {
		// Mirrors the CSS guard on .work-index__cover: no hover, no floating cover.
		const floatCover =
			window.matchMedia('(pointer: fine)').matches &&
			!window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const EASE = 0.16;
		const OFFSET_X = 24;
		const EDGE = 14;

		let frame = 0;
		let hideTimer = 0;
		let visible = false;
		let hovered = null;
		let currentX = 0;
		let currentY = 0;
		let targetX = 0;
		let targetY = 0;

		const clamp = (value, min, max) => Math.max(min, Math.min(value, max));

		const coverBox = () => ({
			width: cover.offsetWidth || 280,
			height: cover.offsetHeight || 175
		});

		// Places the cover next to the cursor, kept inside the viewport.
		const aimAt = (x, y) => {
			const { width, height } = coverBox();
			targetX = clamp(x + OFFSET_X, EDGE, window.innerWidth - width - EDGE);
			targetY = clamp(y - height / 2, EDGE, window.innerHeight - height - EDGE);
		};

		const stopFollow = () => {
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
		};

		const tick = () => {
			// A previous page left this loop running; stop instead of animating a
			// cover that is no longer on screen.
			if (!document.contains(cover)) return;

			// Scrolling can move the row out from under a still pointer, so the
			// hover state — not the last pointer position — decides when to leave.
			if (hovered && !hovered.matches(':hover')) return hideCover();

			currentX += (targetX - currentX) * EASE;
			currentY += (targetY - currentY) * EASE;
			cover.style.transform = `translate3d(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px, 0)`;
			frame = requestAnimationFrame(tick);
		};

		const showCover = (item) => {
			const src = item.getAttribute('data-cover');
			if (src && coverImage.getAttribute('src') !== src) {
				coverImage.setAttribute('src', src);
			}

			hovered = item;
			clearTimeout(hideTimer);

			if (!visible) {
				// The first appearance snaps, so the cover only moves by following.
				visible = true;
				currentX = targetX;
				currentY = targetY;
				cover.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
			}

			cover.classList.add('is-visible');
			if (!frame) frame = requestAnimationFrame(tick);
		};

		const hideCover = () => {
			hovered = null;
			if (!visible) return;

			visible = false;
			cover.classList.remove('is-visible');
			clearTimeout(hideTimer);
			// Let the fade finish before parking the loop.
			hideTimer = setTimeout(stopFollow, 260);
		};

		if (floatCover) {
			list.addEventListener('pointermove', (event) => {
				// Only a real pointer hover drives the cover, never a touch drag.
				if (event.pointerType === 'touch') return hideCover();

				// The whole item, borders included, keeps the cover alive between
				// two rows — hit-testing the inner button would flicker.
				const item = event.target instanceof Element
					? event.target.closest('.work-index__item')
					: null;

				if (!item) return hideCover();

				aimAt(event.clientX, event.clientY);
				showCover(item);
			});

			// Rows open the overlay on click; the cover gets out of its way.
			list.addEventListener('click', hideCover);
		}

		const items = root.querySelectorAll('.work-index__item');
		const filterButtons = root.querySelectorAll('[data-filter]');

		const applyFilter = (value) => {
			items.forEach((item) => {
				item.toggleAttribute(
					'hidden',
					value !== 'all' && item.getAttribute('data-type') !== value
				);
			});

			filterButtons.forEach((button) => {
				const isActive = button.getAttribute('data-filter') === value;
				button.classList.toggle('is-active', isActive);
				button.setAttribute('aria-pressed', String(isActive));
			});
		};

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				applyFilter(button.getAttribute('data-filter'));
			});
		});
	}
</script>

<style>
	.work-index {
		width: 100%;
		max-width: 1180px;
		margin: 0 auto;
		padding: 7rem 1.25rem 8rem;
		color: var(--text-color);
	}

	.work-index__header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-bottom: 1.25rem;
	}

	.work-index__kicker {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-text-secondary);
	}

	.work-index__count {
		color: var(--color-text-main);
	}

	.work-index__filters {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.work-index__filter {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0 0.1rem;
		border: 0;
		background: none;
		color: var(--color-text-secondary);
		font-family: inherit;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.work-index__filter:hover {
		color: var(--text-color);
		text-decoration: line-through;
	}

	.work-index__filter.is-active {
		color: var(--color-text-main);
	}

	.work-index__filter:focus-visible {
		outline: 2px solid var(--color-text-main);
		outline-offset: 2px;
	}

	.work-index__sep {
		color: var(--color-text-main);
		opacity: 0.6;
	}

	.work-index__list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid rgb(255 255 255 / 0.14);
	}

	.work-index__item {
		border-bottom: 1px solid rgb(255 255 255 / 0.14);
	}

	.work-index__item[hidden] {
		display: none;
	}

	/* Touch devices and narrow windows: the thumbnail rides along in the row. */
	.work-index__row {
		display: grid;
		grid-template-columns: clamp(3.5rem, 9vw, 7rem) auto 1fr;
		grid-template-areas:
			'thumb number meta'
			'thumb name name';
		align-items: center;
		column-gap: 0.85rem;
		row-gap: 0.3rem;
		width: 100%;
		padding: 1rem 0.25rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.work-index__row:focus-visible {
		outline: 2px solid var(--color-text-main);
		outline-offset: -2px;
		background: rgb(255 255 255 / 0.03);
	}

	.work-index__thumb {
		grid-area: thumb;
		align-self: center;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: var(--bg-secondary-color);
	}

	.work-index__number {
		grid-area: number;
		align-self: center;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--color-text-main);
	}

	.work-index__name {
		grid-area: name;
		font-family: var(--title-fonts);
		font-size: clamp(1.15rem, 4.6vw, 2rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
	}

	.work-index__row:hover .work-index__name,
	.work-index__row:focus-visible .work-index__name {
		text-decoration: line-through;
	}

	.work-index__meta {
		grid-area: meta;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.6rem;
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-secondary);
	}

	/* TagList sizes itself in em, so it needs a font-size of its own here. */
	.work-index__marker {
		font-size: 0.95rem;
		text-transform: none;
		letter-spacing: normal;
	}

	.work-index__external {
		display: inline-flex;
		color: var(--color-text-main);
	}

	/* A narrow window with a fine pointer has the floating cover, not the thumb. */
	@media (max-width: 600px) and (pointer: fine) {
		.work-index__thumb {
			display: none;
		}
	}

	/* Wide screens with a hover-capable pointer get the editorial single line. */
	@media (min-width: 601px) and (pointer: fine) {
		.work-index {
			padding: 8rem 2.2rem 8rem;
		}

		.work-index__row {
			grid-template-columns: auto 1fr auto;
			grid-template-areas: 'number name meta';
			column-gap: 1.25rem;
			row-gap: 0;
			padding: 1.25rem 0.25rem;
		}

		.work-index__thumb {
			display: none;
		}

		.work-index__name {
			font-size: clamp(1.5rem, 3.6vw, 2.75rem);
		}

		.work-index__meta {
			justify-content: flex-end;
			font-size: 0.7rem;
		}
	}

	.work-index__cover {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 40;
		display: none;
		width: clamp(220px, 24vw, 340px);
		aspect-ratio: 16 / 10;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		background: var(--bg-secondary-color);
		border: 1px solid rgb(255 255 255 / 0.14);
		box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
		transition: opacity 0.2s ease, visibility 0.2s ease;
		will-change: transform;
	}

	.work-index__cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.work-index__cover.is-visible {
		opacity: 1;
		visibility: visible;
	}

	@media (pointer: fine) {
		.work-index__cover {
			display: block;
		}
	}

	/* Reduced motion: no floating at all, the row copy carries the index. */
	@media (prefers-reduced-motion: reduce) {
		.work-index__cover {
			display: none;
			transition: none;
		}
	}
</style>
