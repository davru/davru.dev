---
import TagList from "@components/TagList.astro";
import Layout from "@layouts/Layout.astro";
import data from '../../public/data/posts.json';
import type { BlogPost } from "@lib/models";

// If date null show first as it will be published soon, otherwise sort by date
const posts = ((data as unknown as BlogPost[]) ?? [])
	.filter(p => p.published).sort((a, b) => {
		if (!a.date) return -1;
		if (!b.date) return 1;
		return new Date(b.date).getTime() - new Date(a.date).getTime();
	});
---

<Layout title="Blog - David (davru) Sanchez" description="Blog page for davru.dev where I will be publishing updates for my projects, tips and tricks and other code related articles... or that's what I expect at least :^D">
	<div class="blog-list__wrapper">
	  {posts.map((post) => (
	    <div class="blog-list__post">
	      <header>
					<h3>
	        	<a href={post.date ? `/blog/${post.slug}` : '/blog'} class="blog-list__post_title" transition:name={post.slug}>{ post.title }</a>
	        </h3>
	      </header>

	      {!!post.summary && post.date && <main>{post.summary} <a href={`/blog/${post.slug}`} class="blog-list__post_footer__read-more">read more...</a></main>}

	      <footer class="blog-list__post__footer">
          {post.date ? <time class="blog-list__post__footer__date" data-date={post.date}></time> : <span class="blog-list__post__footer__date">Coming soon...</span>}
	        <TagList tags={post.tags}></TagList>
	      </footer>
	    </div>
	  ))}
	</div>
</Layout>

<script is:inline data-astro-rerun define:vars={{ posts }}>
	const dates = document.querySelectorAll('.blog-list__post__footer__date');
	dates.forEach(date => {
		if (!date.getAttribute('data-date')) return;
		date.innerHTML = window.relativeTime(date.getAttribute('data-date'));
	});

	document.addEventListener('astro:before-swap', ({to, viewTransition, sourceElement}) => {
	  if (to.pathname.includes('blog/') && window.scrollY === 0 && sourceElement.getAttribute('href').includes(posts[0].slug)) {
    	viewTransition.skipTransition()
	  }
	});
</script>

<style>
	.blog-list__wrapper {
	  padding: 6rem 1.75rem 5rem 1.75rem;
	  max-width: 100%;
	  color: var(--text-color);
	}

	.blog-list__wrapper .blog-list__post__footer__date {
	  font-size: .85em;
	  color: var(--color-text-secondary);
	}

	.blog-list__post {
  	width: 700px;
   	max-width: 100%;
	  margin: 0 auto 5rem auto;
	}

	.blog-list__post header {
	  margin: 1.5rem 0;
	}

	.blog-list__post header h3 {
	  font-size: 1.25rem;
	}

	.blog-list__post main {
	  font-size: .85em;
	  line-height: 1.5em;
	  margin-bottom: 1.75em;
	}

	.blog-list__post footer {
		display: flex;
  	flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1em;
	}

	.blog-list__post_footer__read-more {
	  color: var(--color-text-main);
	  font-weight: bold;
	}

	.blog-list__post_footer__read-more:hover {
	  text-decoration: line-through;
	}

	@media (min-width: 600px) {
		.blog-list__post header h3 {
	  	font-size: 1.5rem;
		}

  	.blog-list__wrapper {
   		padding: 9rem 2.2rem 5rem 2.2rem;
	  }

	  .blog-list__post header .blog-list__post_title:hover {
	    text-decoration: line-through;
	  }

	  .blog-list__post_footer__more {
	    width: auto;
	    margin-top: 0;
	  }
	}
</style>
